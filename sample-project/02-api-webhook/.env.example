# ── 필수 ─────────────────────────────────────────────
# 상담 대상 브랜드(채널) 키 — 톡브릿지 센터 > 브랜드, 또는 GET /api/agent/me 의 brands 값
TB_BRAND=your-brand-key

# Agent API 키 (blumnb- 로 시작). 센터에서 발급. 발신하려면 BrandWrite 스코프.
# 웹훅 서명 시크릿(whsec_)과는 별개의 값이다.
TB_API_KEY=blumnb-xxxxxxxx-xxxxxxxx

# 호스티드 게이트웨이 웹훅 서명 시크릿 (whsec_ 로 시작).
# 센터 "상담 받을 곳 연결 → Webhook" 에서 확인한다. Agent 키를 재발급하면 이 값도 바뀐다.
TB_WEBHOOK_SECRET=whsec_change_me

# ── 선택 ─────────────────────────────────────────────
# REST 베이스. 실환경은 https://api.talkbridge.io (기본값).
# 사전 테스트용 개발환경을 제공받았다면 그 주소로 바꾼다 (예: https://api.talkbridge-dev.com)
TB_API_BASE=https://api.talkbridge.io

# 센터에 등록한 내 수신 URL (공인 HTTPS). doctor 가 인터넷 경로로 도달 여부를 검사한다.
# 로컬 개발이면 터널 주소 (예: https://<node>.<tailnet>.ts.net/webhook)
#TB_PUBLIC_URL=https://hook.mycompany.com/webhook

HOST=127.0.0.1
PORT=8788

# 서명 타임스탬프 허용 오차(초). 0 이면 검사 안 함
TB_SIGNATURE_TOLERANCE_SEC=300

# 상담방당 메모리 유지 메시지 수
TB_MAX_MESSAGES=200

# REST 호출 타임아웃(ms)
TB_API_TIMEOUT_MS=15000

# 1 이면 수신 웹훅의 헤더·원본 본문을 콘솔에 찍는다 (페이로드 형식 확인용, 서명값은 앞 12자만)
#TB_DEBUG_WEBHOOK=1
