# ── 필수 ─────────────────────────────────────────────
# 상담 대상 브랜드(채널) 키 — `talkbridge-dev whoami` 의 브랜드 값
TB_BRAND=your-brand-key

# 게이트웨이 webhook sink 의 HMAC 서명 시크릿.
# `npm run gateway:setup` 이 이 값을 CLI 에 그대로 넘긴다 → 양쪽이 같아야 한다.
TB_WEBHOOK_SECRET=whsec_change_me_to_a_long_random_string

# ── 필수(05): Jev(TypeSafe) 키 ───────────────────────
# 키는 이 파일에 적지 않는다. 아래 중 하나로 준다 (위에서부터 우선):
#   1) 환경변수 TYPESAFE_API_KEY      (공식 SDK 와 같은 이름)
#   2) JEV_KEY_FILE 이 가리키는 JSON 파일
#   3) .secret/jev.json               ← .secret/jev.json.tmp 를 복사해 api_key 를 채운다 (커밋 차단됨)
#   4) ../../.secret/jev.json         ← 저장소 루트의 같은 파일
#JEV_KEY_FILE=C:\secrets\jev.json

# ── 선택(05): Jev 호출 ───────────────────────────────
JEV_MODEL=jev-latest
#JEV_BASE_URL=https://api.typesafe.ai
# 공식 SDK 기본값과 같다 — 10초 · 재시도 2회(429·529·5xx·네트워크만)
JEV_TIMEOUT_MS=10000
JEV_MAX_RETRIES=2

# ── 선택(05): 봇 동작 ────────────────────────────────
# 규칙 파일 (없으면 data/demo-bot.json 으로 시작, 저장하면 생성 · 커밋 제외)
#TB_BOT_FILE=data/bot.json
# 이 초보다 오래된 고객 메시지에는 답하지 않는다 — 게이트웨이 저널 재생 시 과거 문의 일괄 답장 방지
TB_BOT_MAX_AGE_SEC=180
# 고객이 끊어 보낸 메시지를 모아 한 번에 답하려고 기다리는 시간(ms)
TB_BOT_DEBOUNCE_MS=1500

# ── 선택 ─────────────────────────────────────────────
# 실행할 CLI. dev = talkbridge-dev / 운영 = talkbridge
TB_CLI=talkbridge-dev

# CLI 실행파일(또는 런처 .js) 경로를 직접 지정하고 싶을 때 (`talkbridge-dev env --json` 의 launcherPath)
#TB_CLI_BIN=C:\Users\me\AppData\Roaming\npm\node_modules\@blumn-dev\talkbridge-cli\bin\talkbridge-dev.js

HOST=127.0.0.1
# 01=8787 · 02=8788 · 03=8789 · (8790·8791 = CLI 지식 조회 API·웹뷰) · 04=8792 → 05 는 8793
PORT=8793

# 게이트웨이에 알려줄 수신 URL(터널을 쓸 때 바꾼다)
#TB_WEBHOOK_URL=https://my-tunnel.example.com/webhook

# 서명 타임스탬프 허용 오차(초). 0 이면 검사 안 함
TB_SIGNATURE_TOLERANCE_SEC=300

# 상담방당 메모리 유지 메시지 수
TB_MAX_MESSAGES=200
