# 키를 채우고 .tmp 확장자를 제거한 버전으로 복사해 사용
# 예: Copy-Item .secret/jev.json.tmp .secret/jev.json   (bash: cp .secret/jev.json.tmp .secret/jev.json)
# .secret/*.json 은 .gitignore 로 커밋이 막혀 있다. 이 .tmp 파일(키 없는 템플릿)만 커밋한다.
# 키 발급: https://console.typesafe.ai/keys
{
  "api_key": "your api key",
  "notes": "커밋가능 템플릿"
}
